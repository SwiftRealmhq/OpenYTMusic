<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de extraccion de datos (Android 12+).
   Ver https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="./exoplayer" />
        <exclude
            domain="file"
            path="./download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <!-- Credenciales (cookie de YouTube, token de Discord, email): fuera de la nube. -->
        <exclude
            domain="file"
            path="./datastore" />
        <exclude
            domain="root"
            path="./app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="./exoplayer" />
        <exclude
            domain="file"
            path="./download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <!-- La sesion no viaja entre dispositivos. -->
        <exclude
            domain="file"
            path="./datastore" />
        <exclude
            domain="root"
            path="./app_webview" />
    </device-transfer>
</data-extraction-rules>
